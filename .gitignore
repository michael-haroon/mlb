# Cache
__pycache__/
*.pyc
.pytest_cache

# Artifacts
artifacts/
*.png

# Logs
# Was "*.logs", which matches nothing any tool in this repo writes -- every logger uses
# ".log" -- so 97 run logs sat untracked-but-unignored and buried real changes in
# `git status`. The 5 .log files already committed stay tracked; git ignores only untracked
# paths, so this cannot silently drop history.
*.log

# Sensitive
.env

# Data files — live on S3, not in git
*.parquet
*.csv
# DL feature-store artifacts (canonical copy: s3://mlb-.../deep_learning/feature_store/)
deep_learning/feature_store/