scripts/.sizing_run_manifest.json
tmp/*.parquet
tmp/*.json
trading/logs/*.jsonl

# Logs
# Was "*.logs", which matches nothing any tool in this repo writes -- every logger uses
# ".log" -- so 97 run logs sat untracked-but-unignored and buried real changes in
# `git status`. The 5 .log files already committed stay tracked; git ignores only untracked
# paths, so this cannot silently drop history.
*.log

# Sensitive
.env

# Local Claude Code tooling config/memory, not project source
.claude/

# Data files — live on S3, not in git
*.parquet
*.csv
# DL feature-store artifacts (canonical copy: s3://mlb-.../deep_learning/feature_store/)
deep_learning/feature_store/
# Scoring-parity fixture: 41 .npy arrays sliced out of the 2.6 GB prepared test split. Kept
# out of git for its size, staged at s3://mlb-.../deep_learning/serving_fixtures/ instead; the
# test that reads it skips when absent and its docstring carries the fetch command.
deep_learning/tests/fixtures/parity_prepared_test/